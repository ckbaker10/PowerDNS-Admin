# Example environment file for docker-compose.
# Copy to `.env` and fill in real values:
#
#   cp .env.example .env
#   $EDITOR .env
#
# Compose loads `.env` automatically. Never commit the populated `.env`.

# REQUIRED. PowerDNS-Admin refuses to start without a non-default
# SECRET_KEY. Generate one with:
#   python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=

# Optional. Salt used as a fixed bcrypt salt when hashing API keys.
# Must be a valid bcrypt salt string (format: $2b$NN$<22 chars>).
# Falls back to a built-in default if empty; set an explicit value in
# production to invalidate any keys minted with the default salt.
# Generate with:
#   python3 -c 'import bcrypt; print(bcrypt.gensalt().decode())'
#
# NOTE for docker-compose: dollar signs in .env files are NOT
# interpolated by Compose, so paste the bcrypt salt value as-is.
# If you set SALT directly in docker-compose.yml environment: blocks
# (not via .env), you must escape each $ as $$ (e.g. $$2b$$12$$...).
SALT=
