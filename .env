# Example environment file for docker-compose.
# Copy to `.env` and fill in real values:
#
#   cp .env.example .env
#   $EDITOR .env
#
# Compose loads `.env` automatically. Never commit the populated `.env`.

# REQUIRED. PowerDNS-Admin refuses to start without a non-default
# SECRET_KEY. Generate one with:
#   python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=96fc1b65df25b7d437e83c722e0f61bada528137c03349d7aa9d1e49ef5ecdf1

# Optional. Salt used for token signing (password-reset / confirmation
# links). Falls back to a built-in default if empty; set an explicit
# value in production. Generate with:
#   python -c 'import secrets; print(secrets.token_hex(16))'
SALT=130721f0d55bc3d04ec09e69f231a6db
